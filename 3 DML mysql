SELECT c.* FROM Customer c JOIN Account a ON c.CustID=a.CustID WHERE a.Balance=(SELECT MAX(Balance) FROM Account);
SELECT c.* FROM Customer c JOIN Account a ON c.CustID=a.CustID WHERE a.Balance=(SELECT MIN(Balance) FROM Account WHERE Account_type='Saving Account');
