DELIMITER //
CREATE PROCEDURE calc_commission()
BEGIN
UPDATE Employee SET commission =
CASE
WHEN salary > 10000 THEN salary*0.004
WHEN salary < 10000 AND TIMESTAMPDIFF(YEAR, DoJ, CURDATE()) > 10 THEN salary*0.0035
WHEN salary < 3000 THEN salary*0.0025
ELSE salary*0.0015
END;
END //
DELIMITER ;

CALL calc_commission();

DELIMITER //
CREATE FUNCTION get_manager(did INT)
RETURNS VARCHAR(50)
DETERMINISTIC
BEGIN
DECLARE mname VARCHAR(50);
SELECT emp_name INTO mname FROM Employee WHERE dept_id=did AND job_title='Manager' LIMIT 1;
RETURN mname;
END //
DELIMITER ;

SELECT get_manager(10);
