db.createCollection("Movies_Data");

db.Movies_Data.insertMany([
{Movie_ID:1,Movie_Name:"A",Director:"Raj",Genre:"Action",BoxOfficeCollection:500},
{Movie_ID:2,Movie_Name:"B",Director:"Raj",Genre:"Drama",BoxOfficeCollection:700},
{Movie_ID:3,Movie_Name:"C",Director:"Karan",Genre:"Action",BoxOfficeCollection:900},
{Movie_ID:4,Movie_Name:"D",Director:"Karan",Genre:"Drama",BoxOfficeCollection:300}
]);

db.Movies_Data.aggregate([
{$group:{_id:"$Director",count:{$sum:1}}}
]);

db.Movies_Data.aggregate([
{$group:{_id:"$Genre",maxCollection:{$max:"$BoxOfficeCollection"}}}
]);

db.Movies_Data.aggregate([
{$group:{_id:"$Genre",maxCollection:{$max:"$BoxOfficeCollection"}}},
{$sort:{maxCollection:1}}
]);

db.Movies_Data.createIndex({Movie_ID:1});

db.Movies_Data.createIndex({Movie_Name:1,Director:1});

db.Movies_Data.dropIndex("Movie_ID_1");

db.Movies_Data.dropIndex("Movie_Name_1_Director_1");
